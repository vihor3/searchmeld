# 复制为 .env 后修改以下必填项
# cp .env.example .env

# 对外端口（宿主机）
HOST_PORT=5173

# install.sh 管理的安装模式；一般不需要手工修改
ONE_SEARCH_INSTALL_MODE=embedded
ONE_SEARCH_USE_SHARED_DB_NETWORK=false

# 内置数据库密码（一体化模式必填；使用外部数据库时留空）
POSTGRES_PASSWORD=

# 外部 PostgreSQL（使用 docker-compose.external-db.yml 时填写）
# PostgreSQL 最低版本为 15；连接串中的特殊字符需进行 URL 编码
DATABASE_URL=
DATABASE_DOCKER_NETWORK=shared-db

# 管理员账号（首次启动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 加密密钥（必填，≥32 字符；丢失后无法解密已存 Key）
# 生成：openssl rand -base64 32
ENCRYPTION_KEY=

# 是否要求搜索 API 带 Token（默认 true）
API_AUTH_REQUIRED=true

# 是否开启 MCP（默认 true）
MCP_ENABLED=true
